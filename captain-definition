{
  "schemaVersion": 2,
  "dockerfileLines": [
    "# Build stage for frontend",
    "FROM node:20-alpine AS builder",
    "WORKDIR /app",
    "COPY package*.json ./",
    "RUN npm ci",
    "COPY . .",
    "RUN npm run build",
    "",
    "# Production stage",
    "FROM node:20-alpine",
    "WORKDIR /app",
    "COPY package*.json ./",
    "RUN npm ci --only=production",
    "COPY --from=builder /app/dist ./dist",
    "COPY server.js ./",
    "COPY prisma ./prisma/",
    "COPY services ./services/",
    "COPY utils ./utils/",
    "RUN npx prisma generate",
    "EXPOSE 3000",
    "CMD [\"node\", \"server.js\"]"
  ]
}
